<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Tab text="Encrypt" xmlns="http://javafx.com/javafx/17.0.12"
     xmlns:fx="http://javafx.com/fxml/1"
     fx:controller="xyz.cursedman.filecrypto.controllers.EncryptTabController"
>
    <VBox spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <StackPane VBox.vgrow="ALWAYS">
            <HBox spacing="20.0">
                <fx:include fx:id="fileTable" source="file-table.fxml" HBox.hgrow="ALWAYS"/>
                <fx:include fx:id="encryptionSettings" source="encryption-settings.fxml"/>
            </HBox>
            <fx:include fx:id="loadingOverlay" source="loading-overlay.fxml"/>
        </StackPane>
        <!-- outside the overlay so Cancel stays clickable -->
        <fx:include fx:id="progressBar" source="progress-bar.fxml"/>
    </VBox>
</Tab>
