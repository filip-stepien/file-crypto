<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Tab text="Decrypt" xmlns="http://javafx.com/javafx/17.0.12"
     xmlns:fx="http://javafx.com/fxml/1"
     fx:controller="xyz.cursedman.filecrypto.controllers.DecryptTabController"
>
    <VBox spacing="10.0">
        <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <StackPane alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
            <fx:include fx:id="decryptionSettings" source="decryption-settings.fxml"/>
            <fx:include fx:id="loadingOverlay" source="loading-overlay.fxml"/>
        </StackPane>
        <!-- outside the overlay so Cancel stays clickable -->
        <fx:include fx:id="progressBar" source="progress-bar.fxml"/>
    </VBox>
</Tab>
