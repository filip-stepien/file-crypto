<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import xyz.cursedman.filecrypto.controls.LabeledProgressBar?>

<Tab text="Benchmark" xmlns="http://javafx.com/javafx/17.0.12"
     xmlns:fx="http://javafx.com/fxml/1"
     fx:controller="xyz.cursedman.filecrypto.controllers.BenchmarkTabController"
>
    <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <StackPane VBox.vgrow="ALWAYS">
                <VBox spacing="10.0">
                    <HBox spacing="20.0">
                        <fx:include fx:id="fileTable" source="file-table.fxml" HBox.hgrow="ALWAYS"/>
                        <VBox prefWidth="250.0" spacing="10.0">
                            <VBox spacing="5.0">
                                <Label text="Benchmark options">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>
                                <Separator prefWidth="200.0"/>
                            </VBox>
                            <Label text="Algorithms"/>
                            <MenuButton fx:id="algorithmsMenu" mnemonicParsing="false" maxWidth="Infinity"/>
                            <VBox spacing="5.0">
                                <Label text="Repetitions per file (median)"/>
                                <Spinner fx:id="repetitionsSpinner" editable="true" prefWidth="250.0"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Test file sizes [MB, comma separated]"/>
                                <TextField fx:id="testFileSizesField" prefWidth="250.0"/>
                                <Button mnemonicParsing="false" maxWidth="Infinity" onAction="#handleGenerateTestFiles"
                                        text="Generate test files"/>
                            </VBox>
                            <Separator/>
                            <Button fx:id="exportCsvButton" mnemonicParsing="false" maxWidth="Infinity"
                                    onAction="#handleExportCsv" text="Export CSV..."/>
                            <Button fx:id="exportChartsButton" mnemonicParsing="false" maxWidth="Infinity"
                                    onAction="#handleExportCharts" text="Export charts PNG..."/>
                        </VBox>
                    </HBox>
                    <TabPane fx:id="resultsTabPane" minHeight="380.0" prefHeight="380.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                        <Tab text="Results">
                            <TableView fx:id="resultsTable">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </Tab>
                        <Tab text="Throughput">
                            <BarChart fx:id="throughputChart" animated="false" title="Average throughput">
                                <xAxis>
                                    <CategoryAxis label="Algorithm"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Throughput [MB/s]"/>
                                </yAxis>
                            </BarChart>
                        </Tab>
                        <Tab text="Time vs size">
                            <LineChart fx:id="timeChart" animated="false" legendSide="RIGHT"
                                       title="Encryption time vs file size">
                                <xAxis>
                                    <NumberAxis label="File size [MB]"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Encryption time [ms]"/>
                                </yAxis>
                            </LineChart>
                        </Tab>
                        <Tab text="Size overhead">
                            <BarChart fx:id="overheadChart" animated="false" legendVisible="false"
                                      title="Ciphertext size overhead">
                                <xAxis>
                                    <CategoryAxis label="Algorithm"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Overhead [B]"/>
                                </yAxis>
                            </BarChart>
                        </Tab>
                    </TabPane>
                </VBox>
                <fx:include fx:id="loadingOverlay" source="loading-overlay.fxml"/>
            </StackPane>
            <!-- while running: current pass, current measurement (repetitions), whole run (below) -->
            <LabeledProgressBar fx:id="passProgress"/>
            <LabeledProgressBar fx:id="measurementProgress"/>
            <fx:include fx:id="progressBar" source="progress-bar.fxml"/>
        </VBox>
</Tab>
